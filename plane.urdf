<?xml version="1.0" ?>
<robot name="plane">
  
  <!-- World link required as the anchor -->
  <link name="world"/>

  <!-- Fixed joint connecting world to the plane link -->
  <joint name="world_to_plane" type="fixed">
    <parent link="world"/>
    <child link="planeLink"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="planeLink">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="100 100 0.01"/> 
      </geometry>
      <material name="light_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="100 100 0.01"/>
      </geometry>
    </collision>
  </link>
</robot>